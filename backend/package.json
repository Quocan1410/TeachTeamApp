{
    "name": "backend",
    "version": "1.0.0",
    "description": "Teaching Tutor Backend API",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "nodemon --exec ts-node src/index.ts",
        "db:reset": "ts-node src/scripts/resetDatabase.ts",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/dataSourceCli.ts",
        "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/dataSourceCli.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^5.1.0",
        "express-rate-limit": "^8.5.2",
        "express-validator": "^7.2.1",
        "helmet": "^8.2.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.1.1",
        "mysql2": "^3.14.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.10",
        "reflect-metadata": "^0.2.2",
        "socket.io": "^4.8.3",
        "typeorm": "^0.3.24"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie": "^0.6.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.18",
        "@types/express": "^5.0.2",
        "@types/express-validator": "^2.20.33",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/multer": "^2.1.0",
        "@types/node": "^22.15.29",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^8.0.0",
        "nodemon": "^3.1.10",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "overrides": {
        "glob": "^11.0.0",
        "rimraf": "^6.0.1"
    }
}
