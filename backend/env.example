# TeachTeamApp backend — this folder only.
# Copy:  cp env.example .env
# Do not read the frontend env or a root .env.

NODE_ENV=development

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
DB_NAME=teachteamapp
# Max connections for this API process. Admin API has its own pool.
DB_CONNECTION_LIMIT=10
# disable | preferred | required. Quote the password if it contains #.
DB_SSL=disable

# --- HTTP ---
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth ---
BACKEND_JWT_SECRET=CHANGE_ME
# Same value as TeachTeamApp-Admin ADMIN_JWT_SECRET, so this API can accept admin tokens on shared routes (avatar).
ADMIN_JWT_SECRET=CHANGE_ME

DEV_OPS_SECRET=CHANGE_ME
# WebAuthn. Leave unset to use the hostname and origin of FRONTEND_URL.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000
