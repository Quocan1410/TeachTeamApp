# TeachTeamApp backend — this folder only.
# Copy:  cp env.example .env
# Do not read the frontend env or a root .env.

NODE_ENV=development

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
DB_NAME=teachteamapp
# disable | preferred | required. Quote the password if it contains #.
DB_SSL=disable

# --- HTTP ---
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth ---
BACKEND_JWT_SECRET=CHANGE_ME
# Same value as TeachTeamApp-Admin ADMIN_JWT_SECRET, so this API can accept admin tokens on shared routes (avatar).
ADMIN_JWT_SECRET=CHANGE_ME

# --- Seed admin (login UI is the admin app) ---
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin

DEV_OPS_SECRET=CHANGE_ME

# --- Password reset email (optional; security questions work without SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@teachteam.app
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Dev accounts after `npm run db:reset` use Password123! for seeded lecturers and candidates.
# Admin password is ADMIN_PASSWORD above.
