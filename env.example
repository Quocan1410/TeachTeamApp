# =============================================================================
# TeachTeamApp — copy to project root:  cp env.example .env
# Never commit .env. Generate secrets: openssl rand -hex 32
# NEXT_PUBLIC_* = public URLs only (embedded in browser bundles).
# =============================================================================

# --- MySQL (shared by backend + admin-backend) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=teachteam
DB_PASSWORD=CHANGE_ME
DB_NAME=teachteamapp

NODE_ENV=development

# --- Main REST API (backend/) ---
BACKEND_PORT=5000
BACKEND_JWT_SECRET=CHANGE_ME

# --- Single system admin (used by main API validation + seed; login UI is in TeachTeamApp-Admin repo) ---
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin

# --- Web app (local dev) ---
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Comma-separated origins allowed by CORS (include admin URL if you run TeachTeamApp-Admin locally)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: protect dev-only DB reset HTTP routes if you re-enable them
DEV_OPS_SECRET=CHANGE_ME

# --- Password reset email (optional; dev logs link to console if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@teachteam.app
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# --- Browser-facing URLs (main frontend reads ../.env via next.config.js) ---
NEXT_PUBLIC_API_ENDPOINT=http://localhost:5000/api
NEXT_PUBLIC_API_ORIGIN=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Optional: link to admin panel from main app (if TeachTeamApp-Admin is running)
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001

# =============================================================================
