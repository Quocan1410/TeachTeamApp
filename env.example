# cp env.example .env — never commit .env
# Secrets: openssl rand -hex 32 (unique each). NEXT_PUBLIC_* = URLs only (public in browser).

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=teachteamapp

NODE_ENV=development

BACKEND_PORT=5000
BACKEND_JWT_SECRET=CHANGE_ME

ADMIN_BACKEND_PORT=4002
ADMIN_JWT_SECRET=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME

FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_PORT=3001
ADMIN_FRONTEND_URL=http://localhost:3001

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DEV_OPS_SECRET=CHANGE_ME

NEXT_PUBLIC_API_ENDPOINT=http://localhost:5000/api
NEXT_PUBLIC_API_ORIGIN=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_GRAPHQL_ENDPOINT=http://localhost:4002/graphql
NEXT_PUBLIC_ADMIN_WS_ENDPOINT=ws://localhost:4002/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4002/graphql
