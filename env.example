# Copy to .env and fill in real values (never commit .env)

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_db_user
DB_PASSWORD=your_strong_db_password
DB_NAME=teachteamapp

NODE_ENV=development

BACKEND_PORT=5000
BACKEND_JWT_SECRET=generate_a_long_random_secret_here

ADMIN_BACKEND_PORT=4002
ADMIN_JWT_SECRET=generate_another_long_random_secret
ADMIN_SESSION_SECRET=generate_session_secret_here

FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

ADMIN_FRONTEND_PORT=3001
ADMIN_FRONTEND_URL=http://localhost:3001

NEXT_PUBLIC_API_ENDPOINT=http://localhost:5000/api
NEXT_PUBLIC_ADMIN_GRAPHQL_ENDPOINT=http://localhost:4002/graphql
NEXT_PUBLIC_ADMIN_WS_ENDPOINT=ws://localhost:4002/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4002/graphql

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Dev-only DB reset routes (production requires header x-dev-ops-key)
DEV_OPS_SECRET=change_me_before_production
