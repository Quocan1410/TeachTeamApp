{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev --prefix ../backend\"",
    "build": "next build",
    "build:full": "npm run build && npm run build --prefix ../backend",
    "start": "next start",
    "start:full": "concurrently \"npm run start\" \"npm run start --prefix ../backend\"",
    "lint": "next lint",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write ./**/*.{ts,tsx,css,md,json} --config ./.prettierrc.json",
    "check-format": "prettier --check ./**/*.{ts,tsx,css,md,json} --config ./.prettierrc.json"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@heroicons/react": "^2.2.0",
    "axios": "^1.9.0",
    "framer-motion": "^12.6.5",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.0.5",
    "next": "^15.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "concurrently": "^8.2.2",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "^15.2.9",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^6.0.1"
  }
}
