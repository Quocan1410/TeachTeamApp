# TeachTeamApp frontend — this folder only.
# Copy:  cp env.example .env
# Public URLs and the upstreams Next rewrites to. No database or JWT secrets.

NEXT_PUBLIC_API_ENDPOINT=/api
NEXT_PUBLIC_API_ORIGIN=
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_GRAPHQL_ENDPOINT=/admin-graphql
NEXT_PUBLIC_ADMIN_WS_ENDPOINT=/admin-graphql
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001

# Must match backend BACKEND_PORT and the admin GraphQL port.
MAIN_API_ORIGIN=http://localhost:5000
ADMIN_GRAPHQL_ORIGIN=http://localhost:4002
